// =============================================================================
//  tcrt/rt.tc — TC 运行时聚合入口
// -----------------------------------------------------------------------------
//  程序只需 `import "tcrt/rt.tc";` 并调用一次 rtInit()。
//
//  运行时全部由 TC 自身实现，最终被编译进目标 EXE：
//      · 不链接 CRT
//      · 不导入 kernel32.dll / ntdll.dll
//      · 产物的导入表始终为空
//
//  由于编译器会剔除不可达函数，未被用到的运行时部分不会进入产物体积。
// =============================================================================

module rt;

import "sys/nt.tc";
import "core/mem.tc";
import "core/io.tc";

/// 初始化运行时。可安全重复调用。
/// 必须在其他 rt* 函数之前执行一次 —— 它负责解析当前系统上的系统调用号。
pub fn rtInit() -> bool {
    if gInited {
        return true;
    }
    if !rtInitSyscalls() {
        return false;
    }
    return true;
}
