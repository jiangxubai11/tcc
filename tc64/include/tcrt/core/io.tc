// =============================================================================
//  tcrt/core/io.tc — 控制台与文件 I/O
// -----------------------------------------------------------------------------
//  全部经 NT 原生系统调用完成，不经过 kernel32.dll，也不使用 CRT 的 FILE。
//  路径在调用前转换为 NT 对象管理器格式：`\??\C:\dir\file`
// =============================================================================

module rt.core.io;

import "../sys/nt.tc";
import "mem.tc";

// ---------------------------------------------------------------------------
//  标准句柄
// ---------------------------------------------------------------------------
//
//  切勿把 -10 / -11 / -12 传给 NtWriteFile —— 那只是 kernel32 的伪句柄约定，
//  内核对它们只会返回 STATUS_INVALID_HANDLE。真正的句柄由装载器写入
//  RTL_USER_PROCESS_PARAMETERS，已在 rtInitSyscalls 中读入 gStdIn/Out/Err。
pub fn rtStdIn()  -> u64 { return gStdIn;  }
pub fn rtStdOut() -> u64 { return gStdOut; }
pub fn rtStdErr() -> u64 { return gStdErr; }

// ---------------------------------------------------------------------------
//  UTF-8 ↔ UTF-16 转换
// ---------------------------------------------------------------------------

pub fn utf8Len(s: *u8) -> u64 {
    var n: u64 = 0;
    while s[n] != 0 {
        n = n + 1;
    }
    return n;
}

pub fn utf16Len(s: *u16) -> u64 {
    var n: u64 = 0;
    while s[n] != 0 {
        n = n + 1;
    }
    return n;
}

/// UTF-8 → UTF-16LE，写入 out（不含结尾 NUL 也一并写入）。返回码元个数。
pub fn utf8ToU16(src: *u8, dst: *u16, cap: u64) -> u64 {
    var n: u64 = 0;
    var i: u64 = 0;
    while src[i] != 0 && n + 1 < cap {
        let c: u64 = src[i] as u64;
        if c < 0x80 {
            dst[n] = c as u16;
            n = n + 1;
            i = i + 1;
        } else if (c & 0xE0) == 0xC0 {
            let c2: u64 = src[i + 1] as u64;
            dst[n] = (((c & 0x1F) << 6) | (c2 & 0x3F)) as u16;
            n = n + 1;
            i = i + 2;
        } else if (c & 0xF0) == 0xE0 {
            let c2: u64 = src[i + 1] as u64;
            let c3: u64 = src[i + 2] as u64;
            dst[n] = (((c & 0x0F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F)) as u16;
            n = n + 1;
            i = i + 3;
        } else {
            // 补充平面 → UTF-16 代理对
            let c2: u64 = src[i + 1] as u64;
            let c3: u64 = src[i + 2] as u64;
            let c4: u64 = src[i + 3] as u64;
            var cp: u64 = ((c & 0x07) << 18) | ((c2 & 0x3F) << 12) |
                          ((c3 & 0x3F) << 6) | (c4 & 0x3F);
            if cp >= 0x10000 {
                cp = cp - 0x10000;
                dst[n]     = (0xD800 | (cp >> 10)) as u16;
                dst[n + 1] = (0xDC00 | (cp & 0x3FF)) as u16;
                n = n + 2;
                i = i + 4;
            } else {
                dst[n] = 0x3F;      // 非法序列 → '?'
                n = n + 1;
                i = i + 1;
            }
        }
    }
    dst[n] = 0;
    return n;
}

/// 读取当前工作目录（RTL_USER_PROCESS_PARAMETERS.CurrentDirectory.DosPath）。
/// 返回写入 out 的码元个数（不含结尾 NUL）；失败返回 0。
fn getCwd(out: *u16, cap: u64) -> u64 {
    let peb: *u8 = read_gs(0x60) as *u8;
    if (peb as u64) == 0 {
        return 0;
    }
    let pp: *u8 = (*((peb + 0x20) as *u64)) as *u8;
    if (pp as u64) == 0 {
        return 0;
    }
    // CurrentDirectory 位于 ProcessParameters + 0x38，其首字段是 UNICODE_STRING DosPath
    let cwd: *UnicodeString = (pp + 0x38) as *UnicodeString;
    var n: u64 = (cwd->len as u64) / 2;
    if n >= cap {
        n = cap - 1;
    }
    var i: u64 = 0;
    while i < n {
        out[i] = cwd->buffer[i];
        i = i + 1;
    }
    out[n] = 0;
    return n;
}

/// 判断路径是否为绝对路径：盘符（`C:`）或反斜杠开头。
fn isAbsPath(path: *u8) -> bool {
    let c0: u8 = path[0];
    if c0 == 92 {
        return true;
    }
    if (c0 >= 97 && c0 <= 122) || (c0 >= 65 && c0 <= 90) {
        return path[1] == 58;
    }
    return false;
}

/// 就地规范化 UTF-16 路径：折叠 `.` 与 `..` 分量。
/// NT 对象管理器不解析 `.`/`..`，必须在这里显式折叠。
/// 写索引恒 ≤ 读索引，因此可以安全地就地覆盖。返回规范化后的码元数。
fn normalizePath(buf: *u16, n: u64) -> u64 {
    var w: u64 = 0;               // 写索引
    var i: u64 = 0;               // 读索引
    while i < n {
        while i < n && buf[i] == 92 {
            i = i + 1;
        }
        if i >= n {
            break;
        }
        let start: u64 = i;
        while i < n && buf[i] != 92 {
            i = i + 1;
        }
        let len: u64 = i - start;

        if len == 1 && buf[start] == 46 {
            // "."：丢弃
        } else if len == 2 && buf[start] == 46 && buf[start + 1] == 46 {
            // ".."：回退一个分量（不越过盘符）
            while w > 0 && buf[w - 1] != 92 {
                w = w - 1;
            }
            if w > 0 {
                w = w - 1;
            }
        } else {
            if w > 0 {
                buf[w] = 92;
                w = w + 1;
            }
            var j: u64 = 0;
            while j < len {
                buf[w] = buf[start + j];
                w = w + 1;
                j = j + 1;
            }
        }
    }
    buf[w] = 0;
    return w;
}

/// 把用户路径拼接到 `\??\` 之后，构造 NT 对象路径。返回码元个数（含前缀）。
///
/// 相对路径会自动拼接当前工作目录，因为 `\??\` 只接受绝对对象路径：
///   `foo\bar`       → `\??\C:\cwd\foo\bar`
///   `..\x\y`        → `\??\C:\cwd 的上一级\x\y`（`.` 与 `..` 被规范化）
///   `C:\foo`        → `\??\C:\foo`
pub fn buildNtPath(path: *u8, dst: *u16, cap: u64) -> u64 {
    if cap < 16 {
        return 0;
    }

    // 1. 先把「CWD + 相对路径」拼进中间缓冲 gNormBuf
    var off: u64 = 0;
    if !isAbsPath(path) {
        let cwdLen: u64 = getCwd(&gNormBuf[0], PATH_CAP);
        off = cwdLen;
        if off > 0 && gNormBuf[off - 1] != 92 && off + 1 < PATH_CAP {
            gNormBuf[off] = 92;
            off = off + 1;
        }
    }
    let n: u64 = utf8ToU16(path, &gNormBuf[0] + off, PATH_CAP - off);
    off = off + n;

    // 2. 折叠 `.` / `..`
    let normLen: u64 = normalizePath(&gNormBuf[0], off);

    // 3. 输出 `\??\` + 规范化路径
    dst[0] = 92;      // '\'
    dst[1] = 63;      // '?'
    dst[2] = 63;      // '?'
    dst[3] = 92;      // '\'
    var i: u64 = 0;
    while i < normLen && i + 4 < cap {
        dst[i + 4] = gNormBuf[i];
        i = i + 1;
    }
    dst[i + 4] = 0;
    return i + 4;
}

// ---------------------------------------------------------------------------
//  控制台输出
// ---------------------------------------------------------------------------

var gIosb: IoStatusBlock;

/// 把 n 字节写入句柄。返回是否成功。
pub fn rtWrite(h: u64, p: *u8, n: u64) -> bool {
    if n == 0 {
        return true;
    }
    let st: i64 = syscall(gNt.writeFile as u64,
                          h,
                          0,                    // Event
                          0,                    // ApcRoutine
                          0,                    // ApcContext
                          &gIosb as u64,
                          p as u64,
                          n,
                          0,                    // ByteOffset（同步 I/O 用文件指针）
                          0);                   // Key
    return st >= 0;
}

pub fn rtPrint(s: *u8) -> void {
    rtWrite(gStdOut, s, utf8Len(s));
}

/// 内建 print 用的分隔符入口：输出一个空格 / 一个换行。
///
/// 为什么做成函数而不是让编译器直接驻留 " " 和 "\n"：
/// 编译器的语义层一旦新建 AST 节点就会挂死（实测过两次）。把这两个常量
/// 放在这里，它们就是普通的源码字符串字面量，走词法器的正规驻留路径。
pub fn rtPrintSp() -> void {
    rtPrint(" ");
}

pub fn rtPrintNl() -> void {
    rtPrint("\n");
}

/// len(s)：字符串的字节数（不含结尾 NUL）。
/// 这是普通库函数，不需要编译器内建。
pub fn len(s: *u8) -> i64 {
    return utf8Len(s) as i64;
}

/// 浮点输出：定点 3 位小数（如 1.500 / -0.250）。
///
/// 只用整数运算实现 —— 不引 CRT、不调系统格式化 API，
/// 符合"导入表为空"的约束。精度固定 3 位，足够调试与引擎数值检查。
pub fn rtPrintF64(v: f64) -> void {
    var neg: bool = false;
    var x: f64 = v;
    if x < 0.0 {
        neg = true;
        x = 0.0 - x;
    }
    // 放大 1000 并四舍五入到整数（NaN / Inf 会落到下面的钳制分支）
    let scaled: f64 = x * 1000.0;
    var n: i64 = 0;
    // 注意：本语言不支持科学计数法（9.0e15 会解析失败），这里用普通小数写法
    if scaled > 9000000000000000.0 {
        n = 9000000000000000;          // 上限钳制，避免转换溢出
    } else {
        n = scaled as i64;
        if scaled - (n as f64) >= 0.5 {
            n = n + 1;
        }
    }
    let ip: i64 = n / 1000;
    let fp: i64 = n % 1000;
    if neg {
        rtPrint("-");
    }
    rtPrintI64(ip);
    rtPrint(".");
    if fp < 10 {
        rtPrint("00");
    } else if fp < 100 {
        rtPrint("0");
    }
    rtPrintI64(fp);
}

pub fn rtPrintN(s: *u8, n: u64) -> void {
    rtWrite(gStdOut, s, n);
}

pub fn rtPrintErr(s: *u8) -> void {
    rtWrite(gStdErr, s, utf8Len(s));
}

/// 立即终止当前进程。退出码经 NTSTATUS 之外的通道返回给父进程。
pub fn rtExit(code: i32) -> void {
    syscall(gNt.terminateProcess as u64, CURRENT_PROCESS, code as u64);
    // NtTerminateProcess 不会返回；此循环仅为让控制流分析满意
    var i: u64 = 0;
    while true {
        i = i + 1;
    }
}

// ---------------------------------------------------------------------------
//  数字格式化
// ---------------------------------------------------------------------------

/// 无符号十进制
pub fn rtPrintU64(v: u64) -> void {
    var buf: [24]u8;
    var n: u64 = 0;
    var x: u64 = v;
    if x == 0 {
        buf[0] = 48;
        n = 1;
    } else {
        while x > 0 {
            buf[n] = (48 + (x % 10)) as u8;
            x = x / 10;
            n = n + 1;
        }
    }
    var out: [24]u8;
    var k: u64 = 0;
    var j: u64 = n;
    while j > 0 {
        j = j - 1;
        out[k] = buf[j];
        k = k + 1;
    }
    rtWrite(gStdOut, &out[0], k);
}

/// 有符号十进制
pub fn rtPrintI64(v: i64) -> void {
    if v < 0 {
        var minus: [1]u8;
        minus[0] = 45;
        rtWrite(gStdOut, &minus[0], 1);
        // 取绝对值：对 INT64_MIN 同样正确（无符号回绕）
        rtPrintU64(0 - (v as u64));
        return;
    }
    rtPrintU64(v as u64);
}

/// 定宽十六进制（大写，width 位）
pub fn rtPrintHex(v: u64, width: u64) -> void {
    var out: [16]u8;
    var i: u64 = 0;
    while i < width && i < 16 {
        let shift: u64 = (width - 1 - i) * 4;
        let d: u64 = (v >> shift) & 0xF;
        if d < 10 {
            out[i] = (48 + d) as u8;
        } else {
            out[i] = (55 + d) as u8;
        }
        i = i + 1;
    }
    rtWrite(gStdOut, &out[0], i);
}

// ---------------------------------------------------------------------------
//  文件
// ---------------------------------------------------------------------------

pub struct File {
    handle: u64;
    size: u64;
    ok: bool;
}

/// 路径缓冲区。
/// 刻意放在 .bss 而非栈上：240 个码元的路径若用局部数组，会给每个文件操作
/// 函数强加 ~2 KiB 的栈帧，而这类函数往往处在深调用链上。运行时是单线程的，
/// 顺序调用不会竞争，因此共享一份即可。
var gPathBuf: [512]u16;      // 最终 NT 路径输出缓冲
var gNormBuf: [512]u16;      // 规范化过程中的中间缓冲
const PATH_CAP: u64 = 512;

fn mkObjAttr(nameBuf: *u16, codeUnits: u64, us: *UnicodeString,
             oa: *ObjectAttributes) -> void {
    us->len      = (codeUnits * 2) as u16;
    us->maxLen   = ((codeUnits + 1) * 2) as u16;
    us->pad      = 0;
    us->buffer   = nameBuf;

    oa->length  = 48;
    oa->pad0    = 0;
    oa->rootDir = 0;
    oa->name    = us;
    oa->attrs   = OBJ_CASE_INSENSITIVE;
    oa->pad1    = 0;
    oa->secDesc = 0;
    oa->secQos  = 0;
}

/// 以只读方式打开已存在的文件
pub fn rtFileOpen(path: *u8) -> File {
    var f: File;
    f.handle = 0;
    f.size   = 0;
    f.ok     = false;

    let n: u64 = buildNtPath(path, &gPathBuf[0], PATH_CAP);
    if n == 0 {
        return f;
    }

    var us: UnicodeString;
    var oa: ObjectAttributes;
    mkObjAttr(&gPathBuf[0], n, &us, &oa);

    var iosb: IoStatusBlock;
    var h: u64 = 0;

    let st: i64 = syscall(gNt.openFile as u64,
                          &h as u64,
                          (GENERIC_READ | SYNCHRONIZE) as u64,
                          &oa as u64,
                          &iosb as u64,
                          (FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE) as u64,
                          (FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT) as u64);
    if st < 0 {
        return f;
    }

    f.handle = h;
    f.ok     = true;
    f.size   = 0;          // 文件大小按需查询（rtFileSize），避免打开时多一次系统调用
    return f;
}

/// 创建或截断文件，用于写入
pub fn rtFileCreate(path: *u8) -> File {
    var f: File;
    f.handle = 0;
    f.size   = 0;
    f.ok     = false;

    let n: u64 = buildNtPath(path, &gPathBuf[0], PATH_CAP);
    if n == 0 {
        return f;
    }

    var us: UnicodeString;
    var oa: ObjectAttributes;
    mkObjAttr(&gPathBuf[0], n, &us, &oa);
    oa.attrs = 0;                       // 新建文件不需要大小写不敏感标记

    var iosb: IoStatusBlock;
    var h: u64 = 0;

    let st: i64 = syscall(gNt.createFile as u64,
                          &h as u64,
                          (GENERIC_READ | GENERIC_WRITE | SYNCHRONIZE) as u64,
                          &oa as u64,
                          &iosb as u64,
                          0,                                   // AllocationSize
                          FILE_ATTRIBUTE_NORMAL as u64,
                          0,                                   // ShareAccess：独占
                          FILE_OVERWRITE_IF as u64,
                          (FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT) as u64,
                          0,                                   // EaBuffer
                          0);                                  // EaLength
    if st < 0 {
        return f;
    }

    f.handle = h;
    f.ok     = true;
    return f;
}

/// 查询文件大小（FileStandardInformation.EndOfFile）
pub fn rtFileSize(f: *File) -> u64 {
    if !f->ok {
        return 0;
    }
    var info: FileStandardInfo;
    var iosb: IoStatusBlock;
    let st: i64 = syscall(gNt.queryInformationFile as u64,
                          f->handle,
                          &iosb as u64,
                          &info as u64,
                          sizeof(FileStandardInfo) as u64,
                          FILE_STANDARD_INFORMATION_CLASS as u64);
    if st < 0 {
        return 0;
    }
    return info.endOfFile as u64;
}

/// 从当前文件指针读取，返回实际读到的字节数
pub fn rtFileRead(f: *File, buf: *u8, n: u64) -> u64 {
    if !f->ok || n == 0 {
        return 0;
    }
    var iosb: IoStatusBlock;
    let st: i64 = syscall(gNt.readFile as u64,
                          f->handle,
                          0, 0, 0,
                          &iosb as u64,
                          buf as u64,
                          n,
                          0,
                          0);
    if st < 0 {
        return 0;
    }
    return iosb.information;
}

pub fn rtFileWrite(f: *File, buf: *u8, n: u64) -> u64 {
    if !f->ok || n == 0 {
        return 0;
    }
    var iosb: IoStatusBlock;
    let st: i64 = syscall(gNt.writeFile as u64,
                          f->handle,
                          0, 0, 0,
                          &iosb as u64,
                          buf as u64,
                          n,
                          0,
                          0);
    if st < 0 {
        return 0;
    }
    return iosb.information;
}

pub fn rtFileClose(f: *File) -> void {
    if f->ok {
        syscall(gNt.close as u64, f->handle);
        f->ok = false;
        f->handle = 0;
    }
}

/// 一次性读入整个文件。返回缓冲区指针（区块分配器分配），长度写入 outLen。
///
/// 采用「分块读取 + 按需扩容」，而不是先查询文件大小再一次性读取：
/// 前者只依赖 NtReadFile，少一次系统调用，也不受文件在读取期间被改动的影响。
/// 缓冲区末尾总会补一个 NUL，便于直接当作 C 字符串使用。
pub fn rtReadWholeFile(path: *u8, outLen: *u64) -> *u8 {
    *outLen = 0;

    var f: File = rtFileOpen(path);
    if !f.ok {
        return null;
    }

    var cap: u64 = 65536;
    var total: u64 = 0;
    var buf: *u8 = rtAlloc(cap + 1, 16);
    if (buf as u64) == 0 {
        rtFileClose(&f);
        return null;
    }

    while true {
        let got: u64 = rtFileRead(&f, buf + total, cap - total);
        if got == 0 {
            break;
        }
        total = total + got;
        if total >= cap {
            let ncap: u64 = cap * 2;
            let nbuf: *u8 = rtAlloc(ncap + 1, 16);
            if (nbuf as u64) == 0 {
                break;
            }
            rtMemCopy(nbuf, buf, total);
            buf = nbuf;
            cap = ncap;
        }
    }

    buf[total] = 0;
    *outLen = total;
    rtFileClose(&f);
    return buf;
}
