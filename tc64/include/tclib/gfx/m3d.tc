// =============================================================================
//  tclib/gfx/m3d.tc — 3D 数学：向量与 4×4 矩阵
// -----------------------------------------------------------------------------
//  约定
//    · 列主序（column-major），与 OpenGL 一致：m[col*4 + row]
//    · 右手坐标系，+X 右、+Y 上、-Z 朝屏内
//    · 角度用弧度
//
//  为什么矩阵用 Vec<f64> 而不是 [16]f64：
//    这个语言的结构体不支持数组字段（编译器源码里也绕开了这一点），
//    而 Vec<T> 作为结构体字段是到处在用的，安全。
// =============================================================================

module tclib.gfx.m3d;

import "../../tcrt/rt.tc";
import "../core/vec.tc";

// ---------------------------------------------------------------------------
//  向量
// ---------------------------------------------------------------------------

pub struct Vec3 {
    x: f64;
    y: f64;
    z: f64;
}

pub struct Vec4 {
    x: f64;
    y: f64;
    z: f64;
    w: f64;
}

pub fn vec3(x: f64, y: f64, z: f64) -> Vec3 {
    var v: Vec3;
    v.x = x; v.y = y; v.z = z;
    return v;
}

pub fn vec4(x: f64, y: f64, z: f64, w: f64) -> Vec4 {
    var v: Vec4;
    v.x = x; v.y = y; v.z = z; v.w = w;
    return v;
}

pub fn vec3Add(a: Vec3, b: Vec3) -> Vec3 {
    return vec3(a.x + b.x, a.y + b.y, a.z + b.z);
}

pub fn vec3Sub(a: Vec3, b: Vec3) -> Vec3 {
    return vec3(a.x - b.x, a.y - b.y, a.z - b.z);
}

pub fn vec3Scale(a: Vec3, s: f64) -> Vec3 {
    return vec3(a.x * s, a.y * s, a.z * s);
}

pub fn vec3Dot(a: Vec3, b: Vec3) -> f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

pub fn vec3Cross(a: Vec3, b: Vec3) -> Vec3 {
    return vec3(a.y * b.z - a.z * b.y,
                a.z * b.x - a.x * b.z,
                a.x * b.y - a.y * b.x);
}

pub fn vec3Len(a: Vec3) -> f64 {
    return sqrt(vec3Dot(a, a));
}

pub fn vec3Normalize(a: Vec3) -> Vec3 {
    let l: f64 = vec3Len(a);
    if l <= 0.0 {
        return vec3(0.0, 0.0, 0.0);
    }
    return vec3Scale(a, 1.0 / l);
}

// ---------------------------------------------------------------------------
//  4×4 矩阵（列主序）
// ---------------------------------------------------------------------------

pub struct Mat4 {
    m: Vec<f64>;        // 16 个元素，下标 col*4 + row
}

pub fn mat4New() -> Mat4 {
    var r: Mat4;
    r.m = vecNew::<f64>();
    var i: u64 = 0;
    while i < 16 {
        vecPush::<f64>(&r.m, 0.0);
        i = i + 1;
    }
    return r;
}

pub fn mat4Get(m: *Mat4, col: u64, row: u64) -> f64 {
    return m->m.data[col * 4 + row];
}

pub fn mat4Set(m: *Mat4, col: u64, row: u64, v: f64) -> void {
    m->m.data[col * 4 + row] = v;
}

pub fn mat4Identity() -> Mat4 {
    var r: Mat4 = mat4New();
    mat4Set(&r, 0, 0, 1.0);
    mat4Set(&r, 1, 1, 1.0);
    mat4Set(&r, 2, 2, 1.0);
    mat4Set(&r, 3, 3, 1.0);
    return r;
}

/// c = a * b（列主序：c[c][r] = Σ a[k][r] * b[c][k]）
pub fn mat4Mul(a: *Mat4, b: *Mat4) -> Mat4 {
    var r: Mat4 = mat4New();
    var c: u64 = 0;
    while c < 4 {
        var rw: u64 = 0;
        while rw < 4 {
            var s: f64 = 0.0;
            var k: u64 = 0;
            while k < 4 {
                s = s + mat4Get(a, k, rw) * mat4Get(b, c, k);
                k = k + 1;
            }
            mat4Set(&r, c, rw, s);
            rw = rw + 1;
        }
        c = c + 1;
    }
    return r;
}

pub fn mat4Translate(x: f64, y: f64, z: f64) -> Mat4 {
    var r: Mat4 = mat4Identity();
    mat4Set(&r, 3, 0, x);
    mat4Set(&r, 3, 1, y);
    mat4Set(&r, 3, 2, z);
    return r;
}

pub fn mat4Scale(x: f64, y: f64, z: f64) -> Mat4 {
    var r: Mat4 = mat4New();
    mat4Set(&r, 0, 0, x);
    mat4Set(&r, 1, 1, y);
    mat4Set(&r, 2, 2, z);
    mat4Set(&r, 3, 3, 1.0);
    return r;
}

pub fn mat4RotateX(rad: f64) -> Mat4 {
    let c: f64 = cos(rad);
    let s: f64 = sin(rad);
    var r: Mat4 = mat4Identity();
    mat4Set(&r, 1, 1, c);
    mat4Set(&r, 2, 1, 0.0 - s);
    mat4Set(&r, 1, 2, s);
    mat4Set(&r, 2, 2, c);
    return r;
}

pub fn mat4RotateY(rad: f64) -> Mat4 {
    let c: f64 = cos(rad);
    let s: f64 = sin(rad);
    var r: Mat4 = mat4Identity();
    mat4Set(&r, 0, 0, c);
    mat4Set(&r, 2, 0, s);
    mat4Set(&r, 0, 2, 0.0 - s);
    mat4Set(&r, 2, 2, c);
    return r;
}

pub fn mat4RotateZ(rad: f64) -> Mat4 {
    let c: f64 = cos(rad);
    let s: f64 = sin(rad);
    var r: Mat4 = mat4Identity();
    mat4Set(&r, 0, 0, c);
    mat4Set(&r, 1, 0, 0.0 - s);
    mat4Set(&r, 0, 1, s);
    mat4Set(&r, 1, 1, c);
    return r;
}

/// 透视投影（fovy 为纵向视角弧度）
pub fn mat4Perspective(fovy: f64, aspect: f64, znear: f64, zfar: f64) -> Mat4 {
    // 语言暂无 tan()：用 sin/cos 代换（cos 为 0 时由 IEEE 的 inf 语义兜底）
    let half: f64 = fovy * 0.5;
    let f: f64 = 1.0 / (sin(half) / cos(half));
    var r: Mat4 = mat4New();
    mat4Set(&r, 0, 0, f / aspect);
    mat4Set(&r, 1, 1, f);
    mat4Set(&r, 2, 2, (zfar + znear) / (znear - zfar));
    mat4Set(&r, 2, 3, 0.0 - 1.0);
    mat4Set(&r, 3, 2, (2.0 * zfar * znear) / (znear - zfar));
    return r;
}

/// 变换一个齐次点
pub fn mat4Transform(m: *Mat4, v: Vec4) -> Vec4 {
    var ox: f64 = 0.0;
    var oy: f64 = 0.0;
    var oz: f64 = 0.0;
    var ow: f64 = 0.0;
    ox = mat4Get(m, 0, 0) * v.x + mat4Get(m, 1, 0) * v.y + mat4Get(m, 2, 0) * v.z + mat4Get(m, 3, 0) * v.w;
    oy = mat4Get(m, 0, 1) * v.x + mat4Get(m, 1, 1) * v.y + mat4Get(m, 2, 1) * v.z + mat4Get(m, 3, 1) * v.w;
    oz = mat4Get(m, 0, 2) * v.x + mat4Get(m, 1, 2) * v.y + mat4Get(m, 2, 2) * v.z + mat4Get(m, 3, 2) * v.w;
    ow = mat4Get(m, 0, 3) * v.x + mat4Get(m, 1, 3) * v.y + mat4Get(m, 2, 3) * v.z + mat4Get(m, 3, 3) * v.w;
    return vec4(ox, oy, oz, ow);
}
