// =============================================================================
//  tclib/win/win32.tc — Win32 GUI 基础库（user32 / gdi32 / advapi32 / kernel32）
// -----------------------------------------------------------------------------
//  项目纪律：不静态导入任何 DLL（产物导入表恒为空）。
//  与 tcrt/sys/nt.tc 同一套做法：PEB → 加载器链表 → 找到目标 DLL →
//  内存中解析导出表 → 得到函数地址，全部经函数指针调用。
//
//  x64 上 WinAPI 与 C 调用约定一致（RCX/RDX/R8/R9 + 栈），且 TC 生成代码
//  不触碰非易失寄存器（RBX/RSI/RDI/R12-R15），因此 TC 函数可直接作为
//  WNDPROC 回调被 Windows 调用。
// =============================================================================

module win.win32;

import "../../tcrt/sys/nt.tc";
import "../../tcrt/core/mem.tc";
import "../../tcrt/core/io.tc";

