pub const WHDR_PREPARED: u32 = 0x00000002;

/// WAVEFORMATEX（x64，size 18）
pub struct WaveFormatEx {
    wFormatTag: u16;        // +0
    nChannels: u16;         // +2
    nSamplesPerSec: u32;    // +4
    nAvgBytesPerSec: u32;   // +8
    nBlockAlign: u16;       // +12
    wBitsPerSample: u16;    // +14
    cbSize: u16;            // +16
}

/// WAVEHDR（x64，size 48）
pub struct WaveHdr {
    lpData: u64;            // +0
    dwBufferLength: u32;    // +8
    dwBytesRecorded: u32;   // +12
    dwUser: u64;            // +16
    dwFlags: u32;           // +24
    dwLoops: u32;           // +28
    lpNext: u64;            // +32
    reserved: u64;          // +40
}

