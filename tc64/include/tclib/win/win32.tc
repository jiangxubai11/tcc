// ---------------------------------------------------------------------------
//  Win32 结构体（x64 布局；对齐由编译器按字段宽度自动处理）
// ---------------------------------------------------------------------------

pub struct Rect {
    left: i32;
    top: i32;
    right: i32;
    bottom: i32;
}

pub struct WinMsg {
    hwnd: u64;      // +0
    message: u32;   // +8
    wParam: u64;    // +16
    lParam: i64;    // +24
    time: u32;      // +32
    ptX: i32;       // +36
    ptY: i32;       // +40
}                   // size 48

pub struct PaintStruct {
    hdc: u64;          // +0
    fErase: i32;       // +8
    left: i32;         // +12    rcPaint
    top: i32;          // +16
    right: i32;        // +20
    bottom: i32;       // +24
    fRestore: i32;     // +28
    fIncUpdate: i32;   // +32
    reserved: [32]u8;  // +36
}                      // size 72

/// BITMAPINFOHEADER 的 x64 内存布局（40 字节），后随 4 字节调色板占位。
/// 实现用「44 字节缓冲 + u32 下标」写入（见 makeBi），不依赖嵌套成员访问：
///   [0] biSize(40) | [1] biWidth | [2] biHeight（负 = top-down） |
///   [3] planes | bitCount<<16 | [4] biCompression(BI_RGB) | [5] biSizeImage |
///   [6] biXPels | [7] biYPels | [8] biClrUsed | [9] biClrImportant
pub const BITMAPINFO_BYTES: u64 = 44;

pub struct WndClassEx {
    cbSize: u32;          // +0
    style: u32;           // +4
    lpfnWndProc: u64;     // +8
    cbClsExtra: i32;      // +16
    cbWndExtra: i32;      // +20
    hInstance: u64;       // +24
    hIcon: u64;           // +32
    hCursor: u64;         // +40
    hbrBackground: u64;   // +48
    lpszMenuName: u64;    // +56
    lpszClassName: u64;   // +64
    hIconSm: u64;         // +72
}                          // size 80

