// =============================================================================
//  tclib/media/mp3.tc — MPEG Audio Layer III 解码器（PCM 输出）
// -----------------------------------------------------------------------------
//  参考 minimp3（公共领域，lieff/minimp3）的标量实现，用 TC 重写。
//  仅支持 Layer III（MPEG-1/2/2.5，32/44.1/48 kHz，mono/stereo/MS/强度立体声）。
//  输出 16-bit 交错 PCM（int16）。
//  算法链：帧头 → Side info → 缩放因子 → 霍夫曼 → 反量化 → 重排序 →
//          立体声 → 混叠消除 → IMDCT → 多相合成滤波器组。
// =============================================================================

module tc.media.mp3;

import "../../tcrt/rt.tc";
import "../../tcrt/core/mem.tc";

// ---------------------------------------------------------------------------
//  常量
// ---------------------------------------------------------------------------

const SHORT_BLOCK_TYPE: i32 = 2;
const STOP_BLOCK_TYPE: i32 = 3;
const MODE_MONO: i32 = 3;
const MODE_JOINT_STEREO: i32 = 1;
const HDR_SIZE: i32 = 4;
const MAX_BITRESERVOIR_BYTES: i32 = 511;
const MAX_L3_FRAME_PAYLOAD_BYTES: i32 = 2304;
const MAX_FRAME_SYNC_MATCHES: i32 = 10;

// ---------------------------------------------------------------------------
//  结构体
// ---------------------------------------------------------------------------

/// 帧信息（对外）
pub struct Mp3FrameInfo {
    frameBytes: u32;
    frameOffset: u32;
    channels: i32;
    hz: i32;
    layer: i32;
    bitrateKbps: i32;
    samples: i32;
}

/// 解码器状态（跨帧持久）
pub struct Mp3Dec {
    header: [4]u8;
    reserv: i32;
    freeFormatBytes: i32;
    mdctOverlap: [576]f64;       // 2 × 9×32
    qmfState: [960]f64;          // 15*2*32
    reservBuf: [511]u8;
}

/// 颗粒信息
struct L3GrInfo {
    part23Length: u32;
    bigValues: u32;
    globalGain: u32;
    scalefacCompress: u32;
    blockType: u32;
    mixedBlockFlag: u32;
    nLongSfb: i32;
    nShortSfb: i32;
    tableSelect: [3]u32;
    regionCount: [3]u32;
    subblockGain: [3]u32;
    preflag: u32;
    scalefacScale: u32;
    count1Table: u32;
    scfsi: u32;
    sfbtab: *u8;                 // 指向缩放因子频带表
}

/// 比特流读取器
struct Bs {
    buf: *u8;
    pos: i32;
    limit: i32;
}

// ---------------------------------------------------------------------------
//  比特流读取
// ---------------------------------------------------------------------------

fn bsInit(bs: *Bs, data: *u8, bytes: i32) -> void {
    bs->buf = data;
    bs->pos = 0;
    bs->limit = bytes * 8;
}

fn bsGetBits(bs: *Bs, n: i32) -> u32 {
    var cache: u32 = 0;
    let s: i32 = bs->pos & 7;
    var shl: i32 = n + s;
    var p: *u8 = bs->buf + ((bs->pos >> 3) as u64);
    bs->pos = bs->pos + n;
    if bs->pos > bs->limit {
        return 0;
    }
    var next: u32 = (p[0] as u32) & (255 >> s);
    p = p + 1;
    shl = shl - 8;
    while shl > 0 {
        cache = cache | (next << shl);
        next = p[0] as u32;
        p = p + 1;
        shl = shl - 8;
    }
    return cache | (next >> (0 - shl));
}

/// 窥视 n 位（读取但不推进 pos，对应 minimp3 的 PEEK_BITS）
fn bsPeekBits(bs: *Bs, n: i32) -> u32 {
    let save: i32 = bs->pos;
    let v: u32 = bsGetBits(bs, n);
    bs->pos = save;
    return v;
}

/// 推进 n 位（对应当 minimp3 的 FLUSH_BITS；n <= 0 时不动）
fn bsSkipBits(bs: *Bs, n: i32) -> void {
    if n <= 0 {
        return;
    }
    bs->pos = bs->pos + n;
    if bs->pos > bs->limit {
        bs->pos = bs->limit;
    }
}

// ---------------------------------------------------------------------------
//  帧头
// ---------------------------------------------------------------------------

fn hdrValid(h: *u8) -> bool {
    return h[0] == 0xFF &&
           ((h[1] & 0xF0) == 0xF0 || (h[1] & 0xFE) == 0xE2) &&
           (((h[1] >> 1) & 3) != 0) &&
           ((h[2] >> 4) != 15) &&
           (((h[2] >> 2) & 3) != 3);
}

fn hdrIsMpeg1(h: *u8) -> bool {
    return (h[1] & 0x08) != 0;
}

fn hdrIsMpeg25(h: *u8) -> bool {
    return (h[1] & 0x10) == 0;
}

fn hdrGetLayer(h: *u8) -> i32 {
    return ((h[1] >> 1) & 3) as i32;
}

fn hdrGetBitrateIdx(h: *u8) -> i32 {
    return (h[2] >> 4) as i32;
}

fn hdrGetSampleRateIdx(h: *u8) -> i32 {
    return ((h[2] >> 2) & 3) as i32;
}

fn hdrIsMono(h: *u8) -> bool {
    return (h[3] & 0xC0) == 0xC0;
}

fn hdrIsMsStereo(h: *u8) -> bool {
    return (h[3] & 0xE0) == 0x60;
}

fn hdrIsIStereo(h: *u8) -> bool {
    return (h[3] & 0x10) != 0;
}

fn hdrTestPadding(h: *u8) -> bool {
    return (h[2] & 0x02) != 0;
}

fn hdrGetMySampleRateIdx(h: *u8) -> i32 {
    // 与 minimp3 一致：MY = sample_rate + (mpeg1位 + 非mpeg2.5位) * 3，再减 1（若非 0）
    let base: i32 = hdrGetSampleRateIdx(h);
    let v1: i32 = ((h[1] >> 3) & 1) as i32;
    let v2: i32 = ((h[1] >> 4) & 1) as i32;
    var my: i32 = base + (v1 + v2) * 3;
    if my != 0 {
        my = my - 1;
    }
    return my;
}

fn hdrSampleRate(h: *u8) -> i32 {
    var hz: i32 = 0;
    let idx: i32 = hdrGetSampleRateIdx(h);
    if idx == 0 { hz = 44100; }
    if idx == 1 { hz = 48000; }
    if idx == 2 { hz = 32000; }
    if !hdrIsMpeg1(h) {
        hz = hz / 2;
    }
    if hdrIsMpeg25(h) {
        hz = hz / 2;
    }
    return hz;
}

fn hdrBitrate(h: *u8) -> i32 {
    // MPEG-1 Layer III 比特率表（kbps）
    let m1l3: [16]i32 = [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 0];
    // MPEG-2/2.5 Layer III
    let m2l3: [16]i32 = [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160, 0];
    let idx: i32 = hdrGetBitrateIdx(h);
    if hdrIsMpeg1(h) {
        return m1l3[idx];
    }
    return m2l3[idx];
}

fn hdrFrameSamples(h: *u8) -> i32 {
    // Layer III：MPEG-1 = 1152，MPEG-2/2.5 = 576
    if hdrIsMpeg1(h) {
        return 1152;
    }
    return 576;
}

fn hdrFrameBytes(h: *u8, freeFormatSize: i32) -> i32 {
    let samples: i32 = hdrFrameSamples(h);
    let kbps: i32 = hdrBitrate(h);
    let hz: i32 = hdrSampleRate(h);
    var fb: i32 = 0;
    if hz > 0 {
        fb = samples * kbps * 125 / hz;
    }
    if fb == 0 {
        return freeFormatSize;
    }
    return fb;
}

fn hdrPadding(h: *u8) -> i32 {
    if hdrTestPadding(h) {
        return 1;
    }
    return 0;
}

